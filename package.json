{
  "name": "ezacx-comm",
  "productName": "MegaZacx",
  "version": "1.0.5",
  "description": "MegaZacx - Discord-style Voice & Text Communication Software",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node src/server/server.js",
    "build:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.ezacx.megazacx",
    "productName": "MegaZacx",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "config.json",
      "version.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MegaZacx",
      "uninstallDisplayName": "MegaZacx",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  }
}
